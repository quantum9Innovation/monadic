cabal-version: 3.14
-- Instructions on how to write this file are in the Cabal
-- documentation, which can be found here:
--   http://haskell.org/cabal/release/cabal-latest/doc/users-guide/
name: monadic
version: 1.0.0.0
license: GPL-3.0-or-later
license-file: LICENSE
copyright: (c) Ananth Venkatesh
author: Ananth Venkatesh
maintainer: Ananth Venkatesh <ananth@monadi.cc>
bug-reports: https://code.functor.systems/q9i/monadic/issues
stability: stable
homepage: https://monadi.cc
synopsis: My new website and blog
category: Web, Text
build-type: Simple
description:
  My new website and blog at https://monadi.cc

source-repository head
  type: git
  location: https://code.functor.systems/q9i/monadic

flag threaded
  default: True

executable monadic
  hs-source-dirs: src
  main-is: Main.hs
  other-modules:
    Constants
    Types
    Utils
    Style

  build-depends:
    base,
    liquidhaskell,
    filepath,
    hakyll,
    text,
    clay,
    process

  default-language: GHC2024
  default-extensions:
    DerivingStrategies
    OverloadedStrings
    MultilineStrings
  
  ghc-options:
    -fplugin=LiquidHaskell

  if flag(threaded)
    ghc-options:
      -threaded
      -rtsopts
      -with-rtsopts=-N
      -XDerivingStrategies
      -XOverloadedStrings
      -XMultilineStrings
      -fplugin=LiquidHaskell
